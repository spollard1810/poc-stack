# -----------------------------------------------------------------------------
# PoC stack configuration: ports, sizes and versions. Optional to edit -
# ./bootstrap.sh asks for the node IP, admin account and logins step by step
# on the first run. Anything left empty is auto-detected / auto-generated.
# -----------------------------------------------------------------------------

# Node IP the apps are reached on. Empty = auto-detect.
NODE_IP=""

# Cluster networks k3s must be installed with (bootstrap checks them, it can't
# change them - see README "Cluster networks"). Devices and the server's own IP
# must be outside both ranges.
POD_CIDR="192.168.254.0/24"       # k3s cluster-cidr
SERVICE_CIDR="192.168.255.0/24"   # k3s service-cidr
CLUSTER_DNS="192.168.255.10"      # k3s cluster-dns (inside SERVICE_CIDR)

# No DNS / no ingress: each app is exposed as a NodePort on the node IP.
#   NetBox  http://<NODE_IP>:30080
#   AWX     http://<NODE_IP>:30081
#   Gitea   http://<NODE_IP>:30082   (git over ssh: <NODE_IP>:30022)
#   Argo CD http://<NODE_IP>:30083
# PostgreSQL and Valkey are cluster-internal only (no external port).
# NodePorts must be in the k3s range 30000-32767.
NETBOX_PORT="30080"
AWX_PORT="30081"
GITEA_PORT="30082"
GITEA_SSH_PORT="30022"
ARGOCD_PORT="30083"
ARGOCD_HTTPS_PORT="30084"   # Argo CD serves plain HTTP; this port is required by the chart

# Admin account for NetBox, AWX, Gitea and Argo CD. These are only defaults:
# ./bootstrap.sh asks for them on the first run (or: ./bootstrap.sh setup) and
# saves your answers in config.local.env. The password is never kept in this
# file - it is typed or generated, and stored in .secrets.env (git-ignored).
# ("admin" is a reserved username in Gitea, hence "pocadmin".)
POC_ADMIN_USER="pocadmin"
POC_ADMIN_EMAIL="pocadmin@poc.local"

# Storage
STORAGE_CLASS="local-path"
POSTGRES_SIZE="20Gi"
VALKEY_SIZE="2Gi"
GITEA_SIZE="10Gi"
NETBOX_MEDIA_SIZE="2Gi"

# Pinned versions (verified 2026-10)
HELM_VERSION="v3.22.0"
POSTGRES_IMAGE="docker.io/library/postgres:16"
VALKEY_IMAGE="docker.io/valkey/valkey:8.1"
NETBOX_CHART_VERSION="8.3.91"     # NetBox v4.7.2
GITEA_CHART_VERSION="12.7.0"      # Gitea 1.27.0
AWX_OPERATOR_VERSION="2.19.1"     # AWX 24.6.1 (latest upstream release)
ARGOCD_CHART_VERSION="10.9.4"     # Argo CD v3.5.3
ESO_CHART_VERSION="2.11.0"        # External Secrets Operator
AWX_EE_IMAGE="quay.io/ansible/awx-ee:24.6.1"
